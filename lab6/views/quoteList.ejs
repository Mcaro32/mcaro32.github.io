<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Quote</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>


<body>

    <main class="list-page">

        <div class="page-header">

            <div>
                <h1>Manage Quotes</h1>

                <p>
                    View, update, or delete quotes currently stored in the database.
                </p>
            </div>

            <a class="back-link" href="/">Back to Dashboard</a>

        </div>

        <div class="table-card">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Quote</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% for (let i=0; i < quotes.length; i++) { %>

                        <tr>

                            <td class="quote-text">
                                “<%= quotes[i].quote %>”
                            </td>

                            <td class="action-links">

                                <a class="edit-link" href="/quote/edit?quoteId=<%= quotes[i].quoteId %>">
                                    Update
                                </a>

                                <a class="delete-link" href="/quote/delete?quoteId=<%= quotes[i].quoteId %>">
                                    Delete
                                </a>

                            </td>

                        </tr>

                        <% } %>

                </tbody>

            </table>

        </div>

    </main>

    <footer>
    CST 336 Internet Programming. 2026 &copy; Caro
</footer>

</body>

</html>